{
  "name": "@meow-meow-dev/shared-configs",
  "version": "1.7.0",
  "description": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/meow-meow-dev/shared-configs.git"
  },
  "license": "MIT",
  "author": "Jérôme <jerome@meow-meow.dev>",
  "type": "module",
  "exports": {
    "./eslint": {
      "import": {
        "types": "./dist/eslint/index.d.ts",
        "default": "./dist/eslint/index.mjs"
      }
    },
    "./prettier": {
      "import": {
        "types": "./dist/prettier/index.d.ts",
        "default": "./dist/prettier/index.mjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup-node",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "prettier:check": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "qa": "pnpm lint:check && pnpm prettier:check && pnpm tsc:check",
    "tsc:check": "tsc -noEmit"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "commitlint": "^19.8.1"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.27.0",
    "@microsoft/api-extractor": "^7.52.8",
    "@tanstack/eslint-plugin-query": "^5.74.7",
    "@tanstack/eslint-plugin-router": "^1.115.0",
    "@tsconfig/node22": "^22.0.1",
    "@types/node": "^22.15.19",
    "@types/react": "^19.1.4",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitest/eslint-plugin": "^1.2.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "9.27.0",
    "eslint-import-resolver-typescript": "^4.3.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^17.18.0",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-package-json": "^0.31.0",
    "eslint-plugin-perfectionist": "^4.13.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-testing-library": "^7.2.1",
    "eslint-plugin-unicorn": "^59.0.1",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-sql": "^0.19.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "react": "^19.1.0",
    "release-please": "^17.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  },
  "packageManager": "pnpm@10.2.1",
  "engines": {
    "node": ">=21.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
